{
  "id": "my-view-runtime-plugin",
  "name": "My View Runtime Plugin (demo)",
  "version": "0.1.0",
  "engines": { "lyshell": "^1.0" },
  "runtime": "node",
  "lifecycle": "persistent",
  "main": "main.js",
  "activationEvents": ["onStartup"],
  "capabilities": ["read", "uiControl", "sessionControl"],
  "contributes": {
    "views": [
      {
        "id": "dashboard",
        "title": "Dashboard",
        "icon": "icon.svg",
        "entry": "views/dashboard.html"
      },
      {
        "id": "picker",
        "title": "Session Picker",
        "entry": "views/picker.html"
      }
    ]
  }
}
